---
type Props = { class?: string; size?: number };
const { class: className } = Astro.props;
const size = Astro.props.size ?? 14;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <path d="M2.5 8h10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
  <path d="M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
</svg>
