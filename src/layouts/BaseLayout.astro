---
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-600.css';
import '../styles/global.css';

import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { site } from '../data/site';

type Props = {
  title: string;
  description: string;
  /** Extra metadata for the page, rendered inside <head>. */
  noindex?: boolean;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
};

const { title, description, noindex = false, ogImage, structuredData } = Astro.props;

/** Canonical URLs always use the production origin with a trailing slash. */
const normalise = (pathname: string) => {
  let path = pathname.split('?')[0].split('#')[0];
  if (!path.endsWith('/') && !path.includes('.')) path = `${path}/`;
  return path;
};
const canonical = new URL(normalise(Astro.url.pathname), site.url).href;
const socialImage = new URL(ogImage ?? '/og/obsidixz-sharing.jpg', site.url).href;
const fullTitle = title.includes('|') ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#111111" />
    <meta name="author" content={site.operator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Obsidixz — the Interlock emblem and wordmark on a dark background" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <script is:inline>
      // Marks JS availability before first paint so the menu and copy controls
      // can be progressively enhanced without flashing dead controls.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
