---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/ui/Arrow.astro';
import BrandArchitecture from '../components/sections/BrandArchitecture.astro';
import { site, values, GENERAL_MAILTO } from '../data/site';
---

<BaseLayout
  title="About Obsidixz | Parent Organisation"
  description="What Obsidixz is, how the parent relates to its businesses, and the mission, vision and values the organisation is built on."
>
  <section class="page-head">
    <div class="wrap">
      <div class="page-head__inner">
        <div>
          <p class="eyebrow">About</p>
          <h1>About Obsidixz</h1>
        </div>
        <p class="lede">
          The organisation behind Obsidixz Real Estate, Obsidixz Commercial and Obsidixz Game Studio.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="what-title">
    <div class="wrap">
      <div class="parent-intro">
        <div>
          <p class="eyebrow">01 — The organisation</p>
          <h2 id="what-title" class="display" style="margin-top:1rem; max-width:24rem;">
            What Obsidixz is.
          </h2>
        </div>
        <div class="parent-intro__body">
          <p class="lede" style="max-width:38rem;">
            <strong>Obsidixz is a parent organisation focused on building, developing and growing
            distinctive businesses across different markets.</strong>
          </p>
          <p>
            Each business has its own market focus, its own audience and its own stage of
            development. The parent holds the shared name and one standard: clarity about what is
            offered, honesty about what is known, and a long view of what is worth building.
          </p>
          <p>
            Obsidixz is an unregistered business brand operated by
            <strong>{site.operator}</strong>, from {site.locality}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--grey section--hairline" aria-labelledby="architecture-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">02 — Brand architecture</p>
        <h2 id="architecture-title" class="display">How the names relate.</h2>
        <p>
          Obsidixz is the parent. The businesses carry the parent name and their market focus.
          Products keep their own identity.
        </p>
      </div>

      <BrandArchitecture caption={false} />

      <p class="caption" style="margin-top:1rem; max-width:52rem;">
        Brand relationships only: this is not a statement of incorporation, subsidiaries or group
        ownership.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="mission-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">03 — Mission and vision</p>
        <h2 id="mission-title" class="display">What it is for. Where it is going.</h2>
      </div>

      <div class="statements" style="margin-top:clamp(2rem,4vw,3rem);">
        <div class="statement">
          <h3>Mission</h3>
          <p>“{site.mission}”</p>
        </div>
        <div class="statement">
          <h3>Vision</h3>
          <p>“{site.vision}”</p>
          <p class="caption">Where Obsidixz is heading.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--grey section--hairline" id="values" aria-labelledby="values-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">04 — Values</p>
        <h2 id="values-title" class="display">Six commitments, kept practical.</h2>
        <p>The standards the businesses are held to.</p>
      </div>

      <ul class="values" style="margin-top:clamp(2rem,4vw,3rem);">
        {
          values.map((value, index) => (
            <li>
              <h3>
                <span aria-hidden="true">0{index + 1}</span>
                {value.name}
              </h3>
              <p>{value.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="status-title">
    <div class="wrap">
      <div class="parent-intro">
        <div>
          <p class="eyebrow">05 — Where things stand</p>
          <h2 id="status-title" class="display" style="margin-top:1rem; max-width:24rem;">
            Where Obsidixz stands.
          </h2>
        </div>
        <div class="parent-intro__body">
          <p>
            Obsidixz is at an early stage of its development. Obsidixz Real Estate and Obsidixz
            Commercial are the current focus; the Obsidixz Game Studio website is still to come.
          </p>
          <p>
            Enquiries about a business are answered by that business. General questions about
            Obsidixz come to the parent inbox.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/businesses/">
              Explore our businesses
              <Arrow />
            </a>
            <a class="btn btn--outline" href={GENERAL_MAILTO}>Email Obsidixz</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
