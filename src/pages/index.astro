---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/ui/Arrow.astro';
import BusinessFeature from '../components/sections/BusinessFeature.astro';
import EmailBlock from '../components/sections/EmailBlock.astro';

import heroImage from '../assets/images/hero-architecture.jpg';
import neighbourhoodImage from '../assets/images/real-estate-neighbourhood.jpg';
import packagingImage from '../assets/images/commercial-packaging.jpg';

import { site, businesses, businessById, values, GENERAL_MAILTO } from '../data/site';

const realEstate = businessById('real-estate');
const commercial = businessById('commercial');
const studio = businessById('game-studio');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/brand/obsidixz-parent-symbol-transparent.png`,
  email: 'obsidixz@outlook.com',
  description: site.descriptionLong,
  founder: { '@type': 'Person', name: site.operator },
};
---

<BaseLayout
  title="Obsidixz | Our Businesses and Shared Foundation"
  description="Discover Obsidixz, the parent brand behind Obsidixz Real Estate, Obsidixz Commercial and Obsidixz Game Studio."
  structuredData={structuredData}
>
  <!-- 1. Photographic hero -->
  <section class="hero" aria-labelledby="hero-title" data-testid="hero">
    <div class="hero__media">
      <Image
        src={heroImage}
        alt="Closely cropped architectural detail of limestone, dark glass and metal fins intersecting in low evening light"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        format="webp"
        quality={78}
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner wrap">
      <div class="hero__body">
        <p class="eyebrow eyebrow--inverse">Parent organisation</p>
        <h1 id="hero-title">
          <span>Distinct businesses.</span>
          <span>A shared foundation.</span>
        </h1>
        <p class="hero__lede">
          Obsidixz brings together businesses with different market focuses under a shared parent
          identity.
        </p>
        <div class="hero__actions">
          <a class="btn btn--on-dark" href="/businesses/" data-testid="hero-primary">
            Explore our businesses
            <Arrow />
          </a>
          <a class="btn btn--ghost-inverse" href="/about/">About Obsidixz</a>
        </div>
      </div>

      <p class="hero__meta">
        Illustrative photograph — architectural detail, not an Obsidixz property.
      </p>

      <ul class="hero__index" aria-label="The businesses in brief">
        {
          businesses.map((business) => (
            <li>
              <a href={business.url ?? `/businesses/#${business.id}`}>
                <span class="num" aria-hidden="true">{business.index}</span>
                <span class="name">{business.name}</span>
                <span class="desc">{business.kicker}</span>
                <Arrow class="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2. Short introduction to the parent organisation -->
  <section class="section" aria-labelledby="parent-title">
    <div class="wrap">
      <div class="parent-intro">
        <div>
          <p class="eyebrow">01 — The organisation</p>
          <h2 id="parent-title" class="display" style="margin-top:1rem; max-width:24rem;">
            The organisation behind the businesses.
          </h2>
        </div>

        <div class="parent-intro__body">
          <p class="lede" style="max-width:36rem;">
            <strong>Obsidixz is a parent organisation focused on building, developing and growing
            distinctive businesses across different markets.</strong>
          </p>
          <p>
            Each business has its own market focus and offering. Explore the businesses below to find
            the service or project relevant to you.
          </p>
          <a class="link-arrow" href="/about/">
            About the organisation
            <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 & 4. Business overview, destinations and the brief Game Studio entry -->
  <section class="section section--grey section--hairline" aria-labelledby="businesses-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">02 — Our businesses</p>
        <h2 id="businesses-title" class="display">Three businesses. Different markets.</h2>
        <p>
          Real Estate and Commercial are the current focus. Obsidixz Game Studio is developing
          Word Quest, and its website is still to come.
        </p>
      </div>

      <div class="stack-lg" style="margin-top:clamp(2.5rem,5vw,4rem);">
        <BusinessFeature
          compact
          business={realEstate}
          image={neighbourhoodImage}
          alt="Established American residential street with detached houses, porches and mature trees in late afternoon light"
          caption="Illustrative photograph — a residential street, not a client property or listing."
        />

        <BusinessFeature
          compact
          business={commercial}
          image={packagingImage}
          alt="Corrugated carton, plain folding cartons, glass jar, kraft paper and material swatches arranged on a dark workshop bench"
          caption="Illustrative photograph — packaging and material samples on a work surface."
          reverse
        />
      </div>
    </div>

    <!-- Brief Game Studio entry -->
    <div class="studio" style="margin-top:clamp(3rem,6vw,5rem);">
      <div class="wrap">
        <div class="studio__id">
          <p class="eyebrow">Business {studio.index}</p>
          <h3 class="studio__name">
            <span class="studio__mark" aria-hidden="true"></span>
            Obsidixz Game Studio
          </h3>
          <span class="studio__status">Website to follow</span>
        </div>
        <div class="studio__body">
          <p>
            Obsidixz Game Studio is the games-focused business within Obsidixz.
            <strong>Word Quest</strong> is its current game project.
          </p>
          <a class="link-arrow" href="/businesses/#game-studio">
            See the Game Studio profile
            <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Shared foundation, kept compact; the full statements live on About -->
  <section class="section section--dark foundation" aria-labelledby="foundation-title">
    <div class="wrap">
      <div class="section-head section-head--inverse">
        <p class="eyebrow eyebrow--inverse">03 — Shared foundation</p>
        <h2 id="foundation-title" class="display" style="color:#fff;">
          Built to the same standard.
        </h2>
        <p>The businesses differ in market and method. They share one standard.</p>
      </div>

      <blockquote class="foundation__quote">
        <p>“{site.mission}”</p>
        <cite>The Obsidixz mission</cite>
      </blockquote>

      <ul class="values-strip" aria-label="The values the businesses are held to">
        {values.map((value) => <li>{value.name}</li>)}
      </ul>

      <div class="foundation__foot">
        <a class="btn btn--ghost-inverse" href="/about/#values">
          Mission, vision and values
          <Arrow />
        </a>
      </div>
    </div>
  </section>

  <!-- 6. General contact invitation -->
  <section class="section invite" aria-labelledby="invite-title">
    <div class="wrap">
      <div class="invite__inner">
        <div class="invite__body">
          <p class="eyebrow">04 — Contact</p>
          <h2 id="invite-title">Start a conversation.</h2>
          <p class="lede" style="margin-top:1.25rem;">
            General enquiries about Obsidixz come to the parent inbox. For work with a specific
            business, its own inbox will reach that business faster.
          </p>
          <a class="link-arrow" href="/contact/" style="margin-top:1.25rem;">
            Business-specific contact routes
            <Arrow />
          </a>
        </div>

        <EmailBlock
          label="General Obsidixz enquiries"
          address="obsidixz@outlook.com"
          href={GENERAL_MAILTO}
          ctaLabel="Email Obsidixz"
          copy
          testId="cta-email"
        />
      </div>
    </div>
  </section>
</BaseLayout>
